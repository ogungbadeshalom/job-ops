{
  "permissions": {
    "allow": [
      "always run the tasks yourself without my command",
      "Bash(npm run *)",
      "Bash(npm --workspace *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx tsx *)",
      "Bash(git stash *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git -C *)",
      "Bash(git add *)",
      "Bash(git restore *)",
      "Bash(ln -s *)",
      "Bash(chmod *)",
      "Bash(ls *)",
      "Bash(node *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-changed.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-reminder.sh"
          }
        ]
      }
    ]
  }
}
